# --- Database ---
POSTGRES_USER=noahub
POSTGRES_PASSWORD=noahub_pw
POSTGRES_DB=noahub
DATABASE_URL=postgresql+psycopg://noahub:noahub_pw@postgres:5432/noahub

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Security ---
# 32-byte (base64) key for AES-GCM encryption of stored credentials.
# Generate: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
SECRET_KEY=please-change-me-base64-32bytes==

# --- Notifier ---
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=alert@noahub.local
ALERT_EMAIL_TO=

# --- AI 프로바이더 (Phase 3) ---
# AI_PROVIDER: 'fallback' | 'mistral' | 'anthropic' | 'huggingface' | 'openai'
#   비우거나 'fallback' 이면 TF-IDF 템플릿 응답 (LLM 키 불필요).
# 모델 예시:
#   mistral     → mistral-large-latest
#   anthropic   → claude-3-5-sonnet-20240620
#   huggingface → meta-llama/Llama-3-70b-instruct
#   openai      → gpt-4o-mini
AI_PROVIDER=fallback
AI_MODEL=
AI_MAX_TOKENS=2000

ANTHROPIC_API_KEY=
HUGGINGFACE_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=

# --- Ingest API ---
# When set, requires X-Ingest-Key header on POST /api/call-logs/ingest.
INGEST_API_KEY=

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
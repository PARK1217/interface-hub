# ============================================================================
# NOA Interface Hub — 환경변수 예시
# `cp .env.example .env` 로 복사 후 실제 값으로 채워서 사용.
# ============================================================================

# --- PostgreSQL (보험사 도메인 DB) -------------------------------------------
POSTGRES_USER=noahub
POSTGRES_PASSWORD=noahub_pw
POSTGRES_DB=noahub
# 호스트 'postgres' 는 docker-compose 서비스명. 외부 PG 면 실제 호스트로 변경.
DATABASE_URL=postgresql+psycopg://noahub:noahub_pw@postgres:5432/noahub

# --- Redis (MQ 시뮬 큐 + 향후 캐시) -----------------------------------------
REDIS_URL=redis://redis:6379/0

# --- 암호화 (AES-GCM 32바이트 base64) ---------------------------------------
# 인터페이스 auth_secret 저장 + JWT 서명에 사용.
# 운영 키: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
SECRET_KEY=please-change-me-base64-32bytes==

# --- 알림 (장애 감지 시 발송 — 비우면 비활성) -------------------------------
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=alert@noahub.local
ALERT_EMAIL_TO=

# --- AI 프로바이더 (Phase 3) ---
# AI_PROVIDER: 'fallback' | 'mistral' | 'anthropic' | 'huggingface' | 'openai'
#   비우거나 'fallback' 이면 TF-IDF 템플릿 응답 (LLM 키 불필요).
# 모델 예시:
#   mistral     → mistral-large-latest
#   anthropic   → claude-3-5-sonnet-20240620
#   huggingface → meta-llama/Llama-3-70b-instruct
#   openai      → gpt-4o-mini
AI_PROVIDER=fallback
AI_MODEL=
AI_MAX_TOKENS=2000

ANTHROPIC_API_KEY=
HUGGINGFACE_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=

# --- Ingest API (외부 시스템이 호출 결과 보고) ------------------------------
# 값을 채우면 POST /api/call-logs/ingest 가 X-Ingest-Key 헤더 검증.
# 비우면 로그인 토큰만으로도 가능.
INGEST_API_KEY=

# --- 인증 / 계정 보안 -------------------------------------------------------
# JWT 서명 키 (비우면 SECRET_KEY 재사용). 운영에선 별도 32바이트 권장.
JWT_SECRET=
# 토큰 유효 기간 (분). 4시간 = 240.
JWT_TTL_MINUTES=240
# N회 연속 로그인 실패 시 M분 잠금. THRESHOLD=0 으로 두면 lockout 비활성.
LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=30
# 비밀번호 정책 — 금감원 권고 (8자 + 영문/숫자/특수문자 3종).
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_COMPLEXITY=true

# --- 앱 ---------------------------------------------------------------------
# development | production. 운영 시 production.
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO